pipeline {
    options { disableConcurrentBuilds() }
    agent {
        docker {
            image 'node:22'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    
    environment {
        // 项目配置
        PROJECT_NAME = 'mail_frontend'
        VERSION = "${new Date().format('yyyyMMdd-HHmmss')}"
        
        // 服务器配置（改这里的路径即可）
        SERVER_HOST = '118.178.181.189'
        SERVER_USER = 'root'
        DEPLOY_PATH = '/var/web/mail/mail_frontend'  // Nginx 静态文件路径
    }
    
    stages {
        stage('准备') {
            steps {
                echo "🚀 开始构建前端: ${PROJECT_NAME}"
            }
        }
        
        stage('构建前端') {
            steps {
                script {
                    sh """
                        cd mail_frontend
                        
                        # 显示当前 Node 版本
                        echo "📦 Node 版本: \$(node --version)"
                        echo "📦 npm 版本: \$(npm --version)"
                        
                        # 启用 pnpm
                        corepack enable
                        corepack prepare pnpm@9.15.9 --activate
                        
                        # 安装依赖并构建
                        pnpm --ignore-workspace install --frozen-lockfile
                        pnpm --ignore-workspace run build
                        
                        # 验证构建结果
                        ls -lh dist/
                    """
                }
            }
        }
        
        stage('打包') {
            steps {
                script {
                    sh """
                        cd mail_frontend
                        tar -czf dist.tar.gz dist
                        sha256sum dist.tar.gz > dist.tar.gz.sha256
                    """
                    archiveArtifacts artifacts: 'mail_frontend/dist.tar.gz*', fingerprint: true
                }
            }
        }
        
        stage('部署') {
            steps {
                script {
                    def packageSha = sh(returnStdout: true, script: 'sha256sum mail_frontend/dist.tar.gz').trim().tokenize(' ')[0]
                    sshagent(credentials: ['server-ssh-key']) {
                        sh """
                            ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new ${SERVER_USER}@${SERVER_HOST} \
                                'mkdir -p /tmp/frontend_deploy/${VERSION}-${BUILD_NUMBER}'
                            scp -o StrictHostKeyChecking=accept-new \
                                mail_frontend/dist.tar.gz mail_frontend/scripts/deploy_frontend.py \
                                ${SERVER_USER}@${SERVER_HOST}:/tmp/frontend_deploy/${VERSION}-${BUILD_NUMBER}/
                            ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new ${SERVER_USER}@${SERVER_HOST} \
                                'python3 /tmp/frontend_deploy/${VERSION}-${BUILD_NUMBER}/deploy_frontend.py \
                                --archive /tmp/frontend_deploy/${VERSION}-${BUILD_NUMBER}/dist.tar.gz \
                                --root ${DEPLOY_PATH} --version ${VERSION}-${BUILD_NUMBER} \
                                --sha256 ${packageSha} --verify-url https://zjkdongao.cn/'
                            ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new ${SERVER_USER}@${SERVER_HOST} \
                                'rm -rf /tmp/frontend_deploy/${VERSION}-${BUILD_NUMBER}'
                        """
                    }
                }
            }
        }
    }
    
    post {
        success {
            echo "✅ 构建成功"
        }
        failure {
            echo "❌ 构建失败"
        }
        always {
            sh "rm -f mail_frontend/dist.tar.gz mail_frontend/dist.tar.gz.sha256 || true"
        }
    }
}
